---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { ARCHIVE, ARCHIVE_GROUPS } from "../../data/archive";

// Drafts never reach the index — and `[...slug].astro` filters identically, so
// the two can't disagree about what exists.
const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const STATUS_LABEL = {
  active: "In progress",
  shipped: "Shipped",
  paused: "Paused",
} as const;

// Columns in `ARCHIVE_GROUPS` order, each sorted newest-first internally.
const archiveColumns = ARCHIVE_GROUPS.map((group) => ({
  group,
  entries: ARCHIVE.filter((a) => a.group === group).sort((a, b) => b.year - a.year),
})).filter((col) => col.entries.length > 0);
---

<Base
  title="Projects"
  description="Rust tooling for coding agents, plus six years of side projects and team work."
>
  <div class="wrap">
    <PageHeader
      eyebrow="Projects"
      title="Things I've built"
      lede="Current work is Rust tooling for coding agents. Below that is the archive — six years of side projects, game jams, and university group work."
    />

    <ul class="grid">
      {
        projects.map((p) => (
          <li>
            <a class="card" href={`/projects/${p.id}/`}>
              <div class="card__top">
                <span class="badge" data-status={p.data.status}>
                  {STATUS_LABEL[p.data.status]}
                </span>
                <span class="card__year">{p.data.year}</span>
              </div>

              <h2 class="card__title">{p.data.title}</h2>
              <p class="card__summary">{p.data.summary}</p>

              {p.data.stack.length > 0 && (
                <ul class="stack">
                  {p.data.stack.map((s) => (
                    <li class="badge badge--stack">{s}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <section class="archive">
      <h2>Archive</h2>
      <p class="archive__note">
        Older projects, kept findable and grouped by who they were built with.
        These link straight to the source.
      </p>

      <div class="archive__columns">
        {
          archiveColumns.map((col) => (
            <div class="archive__col">
              <h3 class="archive__group">
                {col.group}
                <span class="archive__count">{col.entries.length}</span>
              </h3>
              <ul class="archive__list">
                {col.entries.map((a) => (
                  <li>
                    <a href={a.repo} target="_blank" rel="noopener noreferrer">
                      <span class="archive__row">
                        <span class="archive__name">{a.name}</span>
                        <span class="archive__year">{a.year}</span>
                      </span>
                      <span class="archive__blurb">{a.blurb}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  /* Full gutter-to-gutter rather than a narrow column: with only a handful of
     projects, a capped measure leaves most of a wide screen empty and the
     grid below spends that width on content. `min-height` keeps a short list
     from floating in the middle of nowhere. */
  .wrap {
    padding: clamp(2.5rem, 7vh, 5rem) var(--gutter) 6rem;
    min-height: 100svh;
  }

  /* --- shared badge --- */

  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    white-space: nowrap;
  }

  .badge[data-status="active"] {
    color: var(--ember);
    border-color: rgba(255, 138, 60, 0.45);
  }

  .badge--stack {
    color: var(--dim);
  }

  /* --- featured project cards --- */

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.6rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--rule-strong);
    background-color: rgba(255, 138, 60, 0.05);
    transform: translateY(-2px);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card__year {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .card__title {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }

  .card:hover .card__title {
    color: var(--ember);
  }

  .card__summary {
    margin: 0.6rem 0 0;
    flex-grow: 1;
    color: var(--dim);
    font-size: 0.92rem;
    max-width: none;
  }

  .stack {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* --- archive --- */

  .archive {
    margin-top: clamp(4rem, 10vh, 7rem);
  }

  .archive h2 {
    font-size: 1.25rem;
  }

  .archive__note {
    margin: 0.6rem 0 2rem;
    max-width: 56ch;
    color: var(--faint);
    font-size: 0.9rem;
  }

  .archive__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2.5rem;
    align-items: start;
  }

  .archive__col {
    border-top: 1px solid var(--rule-strong);
    padding-top: 1rem;
  }

  .archive__group {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .archive__count {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .archive__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive__list li + li {
    border-top: 1px solid var(--rule);
  }

  .archive__list a {
    display: block;
    padding: 0.75rem 0;
    color: var(--dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .archive__list a:hover,
  .archive__list a:focus-visible {
    color: var(--bone);
  }

  .archive__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .archive__name {
    color: var(--bone);
  }

  .archive__year {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .archive__blurb {
    display: block;
    margin-top: 0.25rem;
    color: var(--faint);
    font-size: 0.82rem;
  }

  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

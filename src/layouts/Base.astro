---
import { SITE } from "../consts";
import Backdrop from "../components/Backdrop.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** "video" on the home page; "still" everywhere else. */
  backdrop?: "video" | "still";
  /** The home page carries its nav inside the hero, so it opts out of the header. */
  showHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  backdrop = "still",
  showHeader = true,
} = Astro.props;

/** Home gets the bare site title; every other page is suffixed. */
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/assets/favicon.ico/favicon.ico" type="image/x-icon" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL("/scene-poster.jpg", SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Backdrop variant={backdrop} />

    {
      showHeader && (
        <header class="site-header">
          <a class="wordmark" href="/">{SITE.title}</a>
          <SiteNav variant="header" />
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--gutter);
    border-bottom: 1px solid var(--rule);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--bone);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--ember);
  }
</style>
